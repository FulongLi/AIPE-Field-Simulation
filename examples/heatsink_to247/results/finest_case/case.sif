Header
  CHECK KEYWORDS Warn
  Mesh DB "." "mesh"
End

Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output Intervals = 1
  Max Output Level = 5
End

Equation 1
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabl
  BiCGstabl polynomial degree = 4
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1e-10
  Linear System Preconditioning = ILU1
  Linear System Residual Output = 100
  Linear System Abort Not Converged = Logical True
  Nonlinear System Max Iterations = 1
  Nonlinear System Convergence Tolerance = 1e-08
  Steady State Convergence Tolerance = 1e-08
End

Solver 2
  Exec Solver = After All
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = "scalars.dat"
  Variable 1 = Temperature
  Operator 1 = max
  Variable 2 = Temperature
  Operator 2 = min
  Variable 3 = Temperature
  Operator 3 = boundary int
  Mask Name 3 = Fp1 Side
  Variable 4 = Temperature
  Operator 4 = area
  Mask Name 4 = Fp1 Side
  Variable 5 = Temperature
  Operator 5 = boundary int
  Mask Name 5 = Fp2 Side
  Variable 6 = Temperature
  Operator 6 = area
  Mask Name 6 = Fp2 Side
  Variable 7 = Temperature
  Operator 7 = boundary int
  Mask Name 7 = Conv Side
  Variable 8 = Temperature
  Operator 8 = area
  Mask Name 8 = Conv Side
  Variable 9 = Temperature
  Operator 9 = boundary max
  Mask Name 9 = Fp1 Side
  Variable 10 = Temperature
  Operator 10 = boundary max
  Mask Name 10 = Fp2 Side
End

Solver 3
  Exec Solver = After All
  Equation = ResultOutput
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "heatsink"
  Vtu Format = Logical True
  Binary Output = Logical True
  Save Geometry Ids = Logical True
End

Body 1
  Name = "heatsink"
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Material 1
  Name = "aluminium"
  Heat Conductivity = 200.0
  Density = 2700.0
  Heat Capacity = 900.0
End

! 20.0 W over 336 mm^2
Boundary Condition 1
  Name = "footprint_1"
  Target Boundaries(1) = 1
  Heat Flux = 59523.80952380952
  Fp1 Side = Logical True
End

Boundary Condition 2
  Name = "footprint_2"
  Target Boundaries(1) = 2
  Heat Flux = 59523.80952380952
  Fp2 Side = Logical True
End

Boundary Condition 3
  Name = "convective"
  Target Boundaries(1) = 3
  Heat Transfer Coefficient = 25.0
  External Temperature = 300.0
  Conv Side = Logical True
End

! uncovered bottom: natural BC = adiabatic
Boundary Condition 4
  Name = "bottom_adiabatic"
  Target Boundaries(1) = 4
End
